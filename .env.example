# URL of your backend API
VITE_API_URL=http://localhost:8001

# Notifications WebSocket base URL — same origin as the backend, ws/wss scheme.
# Local dev: ws://localhost:8001
# Prod behind a reverse proxy: wss://your-domain (no port — proxy forwards
#   /api/v1/ws/notifications to the backend internally; port 8001 has no TLS).
VITE_WS_URL=ws://localhost:8001

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key — register at https://dash.cloudflare.com → Turnstile.
# Leave empty to skip captcha entirely (useful for local dev).
VITE_CAPTCHA_SITE_KEY=
