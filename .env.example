# URL of your backend API
VITE_API_URL=http://localhost:8001

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Google reCAPTCHA v3 — obtain site key at https://g.co/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=
# Google reCAPTCHA v2 (visible checkbox) — fallback shown to Safari users when
# v3 fails. Register a separate v2 key pair in the reCAPTCHA admin console.
VITE_RECAPTCHA_V2_SITE_KEY=